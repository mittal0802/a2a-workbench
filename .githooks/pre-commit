#!/bin/sh
# Rejects commits whose author or committer email is not the repository identity.
expected="mittalkeshav41@gmail.com"
author=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
committer=$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
if [ "$author" != "$expected" ] || [ "$committer" != "$expected" ]; then
  echo "pre-commit: commits in this repo must use $expected (got author=$author committer=$committer)" >&2
  exit 1
fi
